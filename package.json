{
  "name": "@openedx/brand-openedx",
  "version": "1.0.0-semantically-released",
  "description": "The default branding and SASS theme package containing for Open edX applications. This package is designed to be copied and customized.",
  "exports": {
    "./*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:variants-light && npm run build:brand",
    "build:core": "sass --no-source-map paragon/_variables.scss dist/paragon-theme-core.css",
    "build:variants-light": "sass --no-source-map paragon/_overrides.scss dist/paragon-theme-variants-light.css",
    "build:brand": "sass --no-source-map dist/brand.scss dist/brand.css",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeit-labs/kkux-brand-openedx.git"
  },
  "author": "Zeit Labs",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/zeit-labs/kkux-brand-openedx/issues"
  },
  "homepage": "https://github.com/zeit-labs/kkux-brand-openedx#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "sass": "~1.99.0"
  }
}
